# MQTT-Broker
MQTT_URL=mqtt://172.16.2.10:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Sensor-Topics. TOPIC_LETTER leer lassen = Betrieb mit 2 Sensoren.
# Erwartet JSON mit "contact" (true = geschlossen, wie zigbee2mqtt) oder Klartext open/closed bzw. ON/OFF.
TOPIC_SLOT=zigbee2mqtt/briefkasten_schlitz
TOPIC_PARCEL=zigbee2mqtt/briefkasten_paketfach
TOPIC_LETTER=zigbee2mqtt/briefkasten_brieffach
CONTACT_FIELD=contact

# Optional: Topic für «Bewohner am Briefkasten» (ON/OFF). Nicht den Zustand «zuhause» verwenden.
TOPIC_PRESENCE=

# Zustellfenster und Schwellwerte (Sekunden)
WINDOWS=05:00-07:00,11:30-14:30
DEBOUNCE=0.4
PEEK_PARCEL=3
EMPTY_MIN=8
PEEK_SLOT=4
QUIET=10
SLOT_STUCK=20
PARCEL_OPEN_ALARM=60

# Batteriewarnung: Spannung in mV, unter der ein Sensor als schwach gilt
LOW_VOLTAGE_MV=2850

# Ausgabe
BASE_TOPIC=briefkasten
DISCOVERY_PREFIX=homeassistant
PORT=3000
