# MQTT-Broker
MQTT_URL=mqtt://172.16.2.10:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Sensor-Topics. TOPIC_LETTER leer lassen = Betrieb mit 2 Sensoren.
# Erwartet JSON mit "contact" (true = geschlossen, wie zigbee2mqtt) oder Klartext open/closed bzw. ON/OFF.
TOPIC_SLOT=zigbee2mqtt/briefkasten_schlitz
TOPIC_PARCEL=zigbee2mqtt/briefkasten_paketfach
TOPIC_LETTER=zigbee2mqtt/briefkasten_brieffach
CONTACT_FIELD=contact

# Optional: Vergleichssensoren für die Funkdiagnose (Komma-Liste). Werden nur mitgeschrieben, Export: GET /api/messages?since=…
TOPIC_REFERENCE=zigbee2mqtt/w8a-tk-z08-west

# Optional: Topic für «Bewohner am Briefkasten» (ON/OFF). Nicht den Zustand «zuhause» verwenden.
TOPIC_PRESENCE=

# Zustellfenster und Schwellwerte (Sekunden)
WINDOWS=05:00-07:00,11:30-14:30
DEBOUNCE=0.4
PEEK_PARCEL=3
EMPTY_MIN=8
PEEK_SLOT=4
QUIET=10
SLOT_STUCK=20
PARCEL_OPEN_ALARM=60

# Batteriewarnung: Spannung in mV, unter der ein Sensor als schwach gilt
LOW_VOLTAGE_MV=2850

# Ablage: Mit PGHOST (oder DATABASE_URL) speichert der Dienst in PostgreSQL, sonst in Dateien unter DATA_DIR.
# In docker-compose.yml ist die Datenbank bereits eingerichtet.
PGHOST=
PGUSER=mailbox
PGPASSWORD=
PGDATABASE=mailbox

# Zugriffsschutz (empfohlen, sobald der Dienst über eine Domain erreichbar ist).
# Mit Benutzer und Passwort verlangen alle Seiten ausser /health eine Anmeldung (Basic Auth).
# Direkte Zugriffe im LAN (ohne Reverse Proxy) bleiben ohne Anmeldung.
# HEARTBEAT_TOKEN erlaubt nur GET /api/heartbeat?token=… (z.B. für einen automatischen Funkcheck).
DASHBOARD_USER=
DASHBOARD_PASSWORD=
HEARTBEAT_TOKEN=

# Ausgabe
BASE_TOPIC=briefkasten
DISCOVERY_PREFIX=homeassistant
PORT=3000
